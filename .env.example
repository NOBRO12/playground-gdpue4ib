ALPACA_KEY=
ALPACA_SECRET=
ANTHROPIC_API_KEY=

AGENT_DB_PATH=data/agent.db
AGENT_STRATEGIES_DIR=strategies
AGENT_IS_DIR=data/is
AGENT_OOS_DIR=data/oos
AGENT_LIVE_STATE_PATH=data/live_state.json

# Broker: "alpaca" (real paper, needs ALPACA_KEY/SECRET) or "mock" (offline simulator).
# Use AGENT_BROKER=mock for offline development without an Alpaca account.
AGENT_BROKER=alpaca
AGENT_MOCK_BROKER_PATH=data/mock_broker.json

# Set to true ONLY after running paper for at least 3 months of forward data.
# true = real funds on Alpaca's live endpoint (needs LIVE keys, not paper keys).
# Default: false (paper trading). Guardrails apply identically in both modes.
AGENT_LIVE_MODE=false

# Model used by the daily proposer. Sonnet is the cost-balanced default.
# Override with claude-opus-4-7 for higher reasoning, claude-haiku-4-5-20251001 for cheaper runs.
AGENT_PROPOSER_MODEL=claude-sonnet-4-6
AGENT_LOG_LEVEL=INFO
